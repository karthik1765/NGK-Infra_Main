# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized
*.tsx text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.mjs text eol=lf

# Binary files — do not modify
*.jpeg binary
*.jpg binary
*.png binary
*.svg binary
*.ico binary
*.webp binary
